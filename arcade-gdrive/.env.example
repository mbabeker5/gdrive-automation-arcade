# Arcade API Configuration
# Get your API key from https://arcade.dev
ARCADE_API_KEY=your_arcade_api_key_here

# Your Arcade user ID (email address)
ARCADE_USER_ID=your_email@example.com

# Optional: Default parent folder ID for new folders
# DEFAULT_PARENT_FOLDER_ID=

# Optional: Default shared drive ID
# DEFAULT_SHARED_DRIVE_ID=
